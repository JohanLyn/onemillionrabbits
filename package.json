{
  "name": "one-million-rabbits",
  "version": "0.9.0-beta",
  "private": true,
  "type": "module",
  "description": "A cel-shaded horde-survival game: survive a million rabbits with ridiculous weapons.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/postbuild.js",
    "preview": "vite preview --host",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/smoke.mjs --mobile",
    "screens": "node scripts/screens.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  }
}
